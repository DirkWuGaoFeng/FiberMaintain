# =============================================================================
# Fiber Maintenance Agent v7.1 — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# --- LLM Provider Mode: ollama (local) | openai (OpenAI-compatible API) ---
# Global default provider; each tier can override via LLM_*_PROVIDER
LLM_PROVIDER=ollama

# --- OpenAI-compatible API (used when LLM_PROVIDER=openai) ---
# e.g. Alibaba Cloud Bailian / DashScope compatible-mode
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# API Key: OPENAI_API_KEY or DASHSCOPE_API_KEY, either one is fine
OPENAI_API_KEY=
#DASHSCOPE_API_KEY=

# --- LLM Configuration (Ollama, used when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- LLM Three-Tier Models (each tier picks its own provider) ---
# Example hybrid setup: primary=Bailian API (openai), secondary/tertiary=local Ollama
LLM_PRIMARY=qwen2.5:14b
#LLM_PRIMARY_PROVIDER=openai
LLM_SECONDARY=qwen2.5:7b
#LLM_SECONDARY_PROVIDER=ollama
LLM_TERTIARY=qwen2.5:3b
#LLM_TERTIARY_PROVIDER=ollama

# --- Embedding ---
EMBEDDING_MODEL=bge-large
EMBEDDING_DIMENSIONS=1024

# --- 评估独立裁判（异源 Key，书籍 Ch6）---
# 用于 tests/eval/rubric_judge.py 的软维度评判。为消除"同源裁判"偏差，
# 建议指向与被评系统 primary（qwen 系）不同的供应商/模型。
# 留空则回退使用上面的 OPENAI_API_BASE / OPENAI_API_KEY。
EVAL_JUDGE_MODEL=
EVAL_JUDGE_API_BASE=
EVAL_JUDGE_API_KEY=

# --- Backend (WSL C++ Service) ---
FIBER_BACKEND_URL=http://localhost:8080
WS_BACKEND_URL=ws://localhost:8081/ws/v1/events

# --- ChromaDB ---
CHROMADB_HOST=localhost
CHROMADB_PORT=8100

# --- Agent Server ---
AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# --- Data & Config Directories ---
DATA_DIR=data
CONFIG_DIR=config

# --- Circuit Breaker ---
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN=30

# --- Memory ---
MEMORY_DB=data/memory.db

# --- ChromaDB Persist ---
CHROMA_PERSIST_DIR=data/chromadb
