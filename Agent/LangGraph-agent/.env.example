# ============================================================
# Fiber Maintenance Agent - Environment Configuration
# ============================================================

# -- LLM (Ollama) --
OLLAMA_BASE_URL=http://localhost:11434
LLM_PRIMARY=qwen2.5:7b
LLM_FALLBACK=qwen2.5:3b
LLM_FAST=qwen2.5:1.5b

# -- C++ Backend API Gateway --
FIBER_BACKEND_URL=http://localhost:8080

# -- ChromaDB (RAG Vector Store) --
CHROMADB_HOST=localhost
CHROMADB_PORT=8100

# -- LangSmith Tracing (optional) --
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=fiber-maintenance-agent

# -- LangFuse Observability (optional) --
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# -- Agent Settings --
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
BATCH_CHUNK_SIZE=50
BATCH_MAX_TOTAL=200
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN=30

# -- Data Paths --
DATA_DIR=./data
CHECKPOINT_DB=data/checkpoints.db
MEMORY_DB=data/memory.db
CHROMA_PERSIST_DIR=data/chromadb
